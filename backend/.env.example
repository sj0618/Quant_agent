APP_ENV=local
AUTH_ENABLED=true

# Replace with your runtime datastore credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
REDIS_URL=redis://:PASSWORD@HOST:PORT/DB_NUMBER

# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:5173/auth/google/callback
# Generate a distinct high-entropy secret; rotate with the optional PREVIOUS pair.
AI_BACKTEST_SCOPE_HMAC_PRIMARY=replace-with-a-high-entropy-secret
AI_BACKTEST_SCOPE_HMAC_PRIMARY_VERSION=v1
# AI_BACKTEST_SCOPE_HMAC_PREVIOUS=previous-high-entropy-secret
# AI_BACKTEST_SCOPE_HMAC_PREVIOUS_VERSION=v0
# Gate B authority must issue this token with the distinct HMAC secret. Never reuse the OAuth client secret.
AI_BACKTEST_RAW_AUDIT_ADMISSION_HMAC_SECRET=replace-with-a-distinct-high-entropy-secret
AI_BACKTEST_RAW_AUDIT_ADMISSION_HMAC_KEY_VERSION=v1
AI_BACKTEST_RAW_AUDIT_ADMISSION_TOKEN=replace-with-a-signed-gate-b-admission-token
AI_BACKTEST_RAW_AUDIT_ADMISSION_AUDIENCE=quantagent.backend.raw-audit
AI_BACKTEST_RAW_AUDIT_EVIDENCE_ID=gate-b-evidence-id
AI_BACKTEST_RAW_AUDIT_DEPLOYMENT_REVISION=deployment-revision

AUTH_PUBLIC_BACKEND_ORIGIN=http://127.0.0.1:8000
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5173
AUTH_ALLOWED_HOSTS=localhost,127.0.0.1
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
